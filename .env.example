# 前端可见变量（VITE_ 前缀会打包进前端）
VITE_API_BASE=/api/v1
# 本地开发代理目标（仅 dev 用，生产环境留空走同源）
VITE_API_TARGET=http://localhost:8787
# 注册初始赠送积分（仅展示/前端兜底，真实数值以后端为准）
VITE_INITIAL_CREDITS=10

# ---- 服务端变量（仅后端进程读取，不要加 VITE_ 前缀，不会下发前端）----
# 方式一（兼容旧版单渠道）：填了即作为默认渠道（OpenAI 兼容协议）
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_CHAT_MODEL=
MODEL_IMAGE_MODEL=

# 方式二（多渠道）：在 server/channel-registry.js 配置渠道定义，
# 各渠道密钥通过对应环境变量注入；新增渠道只需加定义 + 配 Key。
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=        # 预留位，需可访问海外网络
# ZHIPU_API_KEY=         # 智谱文生图（CogView / GLM-Image）
# ARK_API_KEY=           # 火山方舟：Seedream 图像 + Seedance 视频
# DASHSCOPE_API_KEY=     # 阿里百炼：万相视频（新版 Key 以 sk-ws 开头）
# SILICONFLOW_API_KEY=   # 硅基流动：聚合图片渠道（Kolors / FLUX 等）

# 注册初始赠送积分（服务端）
INITIAL_CREDITS=10

